# Vite server-side proxies for an isolated backend. No credentials belong here.
CHATNOW_API_TARGET=http://127.0.0.1:9000
CHATNOW_WS_TARGET=ws://127.0.0.1:9001
# Browser endpoints default to same-origin /service and /ws.
